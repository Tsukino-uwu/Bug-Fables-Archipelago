# The game's own files never enter the repo: its assemblies, anything decompiled from them, its assets.
*.dll
*.pdb
# The one exception: the mod download staged by dev-scripts/build-release.ps1 (our DLL and its MIT libraries).
!release/mod/BepInEx/plugins/BugFablesAP/*.dll
decompiled/
lib/

# Build output
bin/
obj/
*.user
.vs/

# Python
__pycache__/
*.pyc
.pytest_cache/

# Logs and scratch
*.log
logs/
scratch/

# Packaged worlds are build output: make them with "Build APWorlds" in the Archipelago checkout, never commit them.
*.apworld

# Dev builds staged by dev-scripts/stage-dev.ps1 and copied in by copy-dev.ps1, with its backups (stage/backup).
stage/
