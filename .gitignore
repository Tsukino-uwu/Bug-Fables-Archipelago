# The game's own files never enter the repo: its assemblies, anything decompiled from them, its assets.
*.dll
*.pdb
decompiled/
lib/

# Build output
bin/
obj/
*.user
.vs/

# Python
__pycache__/
*.pyc
.pytest_cache/

# Logs and scratch
*.log
logs/
scratch/

# Packaged worlds are build output: make them with "Build APWorlds" in the Archipelago checkout, never commit them.
*.apworld
