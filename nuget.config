<?xml version="1.0" encoding="utf-8"?>
<!--
  BepInEx.Core and UnityEngine.Modules aren't on nuget.org. nuget.bepinex.dev is the feed the BepInEx
  project publishes to. One file at the root, because NuGet looks for it walking up from each project.
  The mapping pins each package to one feed, so a same-named package on the other can never be picked.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="bepinex" value="https://nuget.bepinex.dev/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="bepinex">
      <package pattern="BepInEx.*" />
      <package pattern="UnityEngine.Modules" />
    </packageSource>
  </packageSourceMapping>
</configuration>
