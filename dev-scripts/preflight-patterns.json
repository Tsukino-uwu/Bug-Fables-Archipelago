  "agent_settings": {
    "about": "What .claude/settings.json may hold: Claude Code runs its hooks for anyone who opens the repo in it.",
    "permission_lists": [
      "ask",
      "deny"
    ],
    "hook_events": [
      "PreToolUse"
    ],
    "hook_commands": [
      "cd \"$CLAUDE_PROJECT_DIR\" && if command -v py >/dev/null 2>&1; then py -3 -B .claude/hooks/agent-guard.py; else python3 -B .claude/hooks/agent-guard.py; fi || { echo \"agent-guard could not run (it needs py -3 or python3), so nothing was checked: refusing\" >&2; exit 2; }"
    ]
  },
