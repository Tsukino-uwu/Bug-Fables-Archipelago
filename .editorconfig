# The code style, applied by most editors: 4-space indents, braces on their own line, lines up to 120.
root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,py,ps1}]
indent_style = space
indent_size = 4
max_line_length = 120

[*.cs]
csharp_new_line_before_open_brace = all
csharp_prefer_braces = true

[*.{json,yml,yaml}]
indent_style = space
indent_size = 2
