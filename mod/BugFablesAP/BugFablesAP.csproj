<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compiles against your own game assembly (HintPath, Private=false: nothing of the game is copied out).
       Another install: dotnet build -p:BugFablesDir="D:\Games\Bug Fables" -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>BugFablesAP</AssemblyName>
    <RootNamespace>BugFablesAP</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Not portable: ScriptEngine can't read a portable pdb, and the plugin then silently never loads. -->
    <DebugType>full</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- The game ships none of the referenced libraries: copy them to the output. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <BugFablesDir Condition="'$(BugFablesDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Bug Fables</BugFablesDir>
    <GameManaged>$(BugFablesDir)\Bug Fables_Data\Managed</GameManaged>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Core" Version="5.4.*" />
    <!-- The game's Unity version. -->
    <PackageReference Include="UnityEngine.Modules" Version="2018.4.12" IncludeAssets="compile" />
    <!-- Only downloaded: the net40 build is referenced below, since its websocket-sharp can compress in this Mono. -->
    <PackageReference Include="Archipelago.MultiClient.Net" Version="6.7.1" ExcludeAssets="all" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Archipelago.MultiClient.Net">
      <HintPath>$(PkgArchipelago_MultiClient_Net)\lib\net40\Archipelago.MultiClient.Net.dll</HintPath>
    </Reference>
    <Reference Include="websocket-sharp">
      <HintPath>$(PkgArchipelago_MultiClient_Net)\lib\net40\websocket-sharp.dll</HintPath>
    </Reference>
    <!-- netstandard2.0, not net40: the net40 build needs Reflection.Emit, which this Mono lacks. Same version, so it binds. -->
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(PkgArchipelago_MultiClient_Net)\lib\netstandard2.0\Newtonsoft.Json.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
